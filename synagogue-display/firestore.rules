rules_version = '2';

// Public read (the TV display never signs in), writes only from a signed-in
// gabbai (Firebase Authentication - users are created from the console,
// there is no public sign-up form). See README.md for the setup steps.
service cloud.firestore {
  match /databases/{database}/documents {
    match /synagogues/{synagogueId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{collection}/{docId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
