# ==============================================================================
# AI Investment Advisor - Environment configuration
# Copy this file to ".env" and fill in real values. Never commit the real ".env".
# ==============================================================================

APP_ENV=development
LOG_LEVEL=INFO

# --- Market data providers ---------------------------------------------------
# yfinance needs no key and is used as the default/free provider.
# Polygon.io is used as the paid fallback / primary when configured.
POLYGON_API_KEY=
STOCK_DATA_PRIMARY_PROVIDER=yfinance   # yfinance | polygon

# --- News providers ------------------------------------------------------------
NEWSAPI_KEY=
ALPHA_VANTAGE_KEY=
NEWS_PRIMARY_PROVIDER=newsapi          # newsapi | alpha_vantage

# --- SEC filings ---------------------------------------------------------------
# sec-api.io key (https://sec-api.io). If empty, the service falls back to the
# free public SEC EDGAR APIs (data.sec.gov / efts.sec.gov), which require a
# descriptive User-Agent identifying your application per SEC.gov rules.
SEC_API_KEY=
SEC_EDGAR_USER_AGENT="AI Investment Advisor contact@example.com"

# --- AI engine (Claude via LangChain / LlamaIndex) ------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Database (UTF-8 encoding is enforced in code; no special flag needed for
#     SQLite/Postgres, but keep the charset explicit in production URLs) -------
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- Background scheduler (in-process APScheduler, no broker required) --------
SCHEDULER_ENABLED=true
NEWS_POLLING_INTERVAL_MINUTES=20
DAILY_SCAN_HOUR_UTC=7
DAILY_SCAN_MINUTE_UTC=0

# --- API server ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8501,http://localhost:3000
